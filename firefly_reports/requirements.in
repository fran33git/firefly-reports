# numpy is a transitive dep of matplotlib. Capped because numpy>=2.5.0
# requires Python>=3.12, and this project supports Python>=3.11 (CI
# matrix runs both 3.11 and 3.12). Without this cap, pip-compile (and
# Dependabot's lockfile regeneration) picks the latest numpy and
# breaks installation on 3.11.
numpy<2.5

# contourpy>=1.4.0 requires Python>=3.12 (transitive dep of matplotlib);
# capped for the same reason as numpy above.
contourpy<1.5
