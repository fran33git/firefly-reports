# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.
# Precedence: command-line flag > firefly-reports.toml > these variables.

FIREFLY_URL=https://your-firefly-instance.example.com
FIREFLY_TOKEN=your-personal-access-token-here

# Optional. Output language for reports and ledger export: en or it
# (precedence: --lang > firefly-reports.toml `lang` > FIREFLY_LANG > en)
# FIREFLY_LANG=en

# Optional. Use the legacy PDF styles for `report` (true/1)
# FIREFLY_LEGACY_REPORT=false
